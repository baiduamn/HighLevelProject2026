# 从机固件目标芯片
CONFIG_IDF_TARGET="esp32s3"

# Flash：S3 模组最小 4MB
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# 从机编号：烧到不同从机时改成 1 ~ 8
CONFIG_NODE_DEVICE_ID=1

# 默认使用板载 BOOT 按键（GPIO0，按下接地）
CONFIG_NODE_BUTTON_GPIO=0
CONFIG_NODE_BUTTON_ACTIVE_LOW=y

# 板载 WS2812（ESP32-S3-DevKitC-1，GPIO48）
CONFIG_NODE_LED_TYPE_WS2812=y
CONFIG_NODE_LED_GPIO=48
