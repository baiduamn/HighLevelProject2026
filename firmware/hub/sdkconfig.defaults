# 主机固件目标芯片
CONFIG_IDF_TARGET="esp32s3"

# Flash：S3 模组最小 4MB。8MB/16MB 的板子也能用，只是上半天闲置；
# 以后需要 OTA 或存储空间时再调整分区表即可。
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# 自定义分区表：app 区 3MB（见 partitions.csv）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 板载 LED：默认按 ESP32-S3-DevKitC-1 的 WS2812（GPIO48）配置
CONFIG_HUB_LED_TYPE_WS2812=y
CONFIG_HUB_LED_GPIO=48
